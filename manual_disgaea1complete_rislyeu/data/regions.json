    "Angel": {
      "requires": ["|Angel| AND |Cleric F| AND |Knight| AND |Archer| AND |Cave of Ordeals| AND |Progressive Demon Rank:6|"]
    },
    "Majin": {
      "requires": ["|Majin| AND |Warrior M| AND |Brawler M| AND |Ninja| AND |Rogue| AND |Cave of Ordeals| AND |Progressive Demon Rank:6|"]
